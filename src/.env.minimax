#!/usr/bin/env bash
: "${POD_RUNTIME_DIR:=/workspace/pod-runtime}"

# Source the generic pod-runtime environment.

source "${POD_RUNTIME_DIR}/.env"

# These overrides are specific to the MiniMax pod-runtime. They are not intended to be
# used in other ComfyUI pods. The generic resolver always installs the default set
# first, then adds the MiniMax-specific set. 

export TORCH_CUDA=cu130
export TORCH_CHANNEL=stable
export TORCH_STABLE_VER=2.11.0
export TORCH_INDEX=https://download.pytorch.org/whl/cu130
export CUPY_VER=cupy-cuda13x

# Use the standard manifest from the same pod-runtime revision that owns this
# launcher. The generic resolver always installs default first, then this
# MiniMax-specific additive set.
export CUSTOM_NODES_MANIFEST_URL_OVERRIDE="${CUSTOM_NODES_MANIFEST_URL_OVERRIDE:-${POD_RUNTIME_DIR}/custom_nodes_manifest.json}"
export CUSTOM_NODE_SETS="${CUSTOM_NODE_SETS:-minimax}"

# Model selection is deliberately generic. The launcher does not interpret
# MiniMax model size, task or quantization; the selected HF families own that.
export HF_BASE_DOWNLOADS="${HF_BASE_DOWNLOADS:-minimax}"
export HF_LORA_DOWNLOADS="${HF_LORA_DOWNLOADS:-}"

export ENABLE_MODEL_MANIFEST_DOWNLOAD="${ENABLE_MODEL_MANIFEST_DOWNLOAD:-true}"
export INSTALL_CUSTOM_NODES="${INSTALL_CUSTOM_NODES:-true}"
export ENABLE_CIVITAI_DOWNLOAD=false

export MAX_GPU_SESSIONS=0
export PORT_MAIN=8188
export START_TIMEOUT="${START_TIMEOUT:-180}"

# Availability and global activation are separate. ENABLE_SAGE ensures the
# architecture/Torch-specific SageAttention bundle exists. Instance-wide
# attention can then be left at Comfy defaults or explicitly switched to Sage
# or Comfy Kitchen. With both launch switches false, Sage remains available to
# KJ's per-workflow patch node.
export ENABLE_SAGE="${ENABLE_SAGE:-true}"
export COMFY_USE_SAGE_ATTENTION="${COMFY_USE_SAGE_ATTENTION:-false}"
export COMFY_USE_KITCHEN_ATTENTION="${COMFY_USE_KITCHEN_ATTENTION:-false}"

# Current upstream MiniMax disables DynamicVRAM. Keep it profile-specific and
# independently overrideable instead of baking the argument into run_comfy_mux.
export COMFY_DISABLE_DYNAMIC_VRAM="${COMFY_DISABLE_DYNAMIC_VRAM:-true}"
