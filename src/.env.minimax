#!/usr/bin/env bash
: "${POD_RUNTIME_DIR:=/workspace/pod-runtime}"
source "${POD_RUNTIME_DIR}/.env"

export NETWORK_VOLUME=/workspace
export COMFY_APP=/opt/ComfyUI
export COMFY_STATE=/workspace/ComfyUI
export COMFY_HOME="${COMFY_STATE}"
export COMFY="${COMFY_STATE}"
export COMFYUI_PATH="${COMFY_APP}"
export COMFY_LOGS=/workspace/logs
export CUSTOM_DIR="${COMFY_STATE}/custom_nodes"
export CACHE_DIR="${COMFY_STATE}/cache"
export OUTPUT_DIR="${COMFY_STATE}/output"
export WORKFLOW_DIR="${COMFY_STATE}/user/default/workflows"
export MODELS_DIR="${COMFY_STATE}/models"
export DIFFUSION_MODELS_DIR="${MODELS_DIR}/diffusion_models"
export TEXT_ENCODERS_DIR="${MODELS_DIR}/text_encoders"
export VAE_DIR="${MODELS_DIR}/vae"

export TORCH_CUDA=cu130
export TORCH_CHANNEL=stable
export TORCH_STABLE_VER=2.11.0
export TORCH_INDEX=https://download.pytorch.org/whl/cu130
export CUPY_VER=cupy-cuda13x

# Use the shared pod-runtime manifests. The generic custom-node resolver always
# installs the default set first, then adds this MiniMax-specific set.
export CUSTOM_NODE_SETS="${CUSTOM_NODE_SETS:-minimax}"

# Model selection is deliberately generic. The launcher does not interpret
# MiniMax model size, task or quantization; the selected HF families own that.
export HF_BASE_DOWNLOADS="${HF_BASE_DOWNLOADS:-minimax}"
export HF_LORA_DOWNLOADS="${HF_LORA_DOWNLOADS:-}"

export ENABLE_MODEL_MANIFEST_DOWNLOAD="${ENABLE_MODEL_MANIFEST_DOWNLOAD:-true}"
export INSTALL_CUSTOM_NODES="${INSTALL_CUSTOM_NODES:-true}"
export ENABLE_CIVITAI_DOWNLOAD=false
export LAUNCH_JUPYTER=false
export ENABLE_MY_REPO_DOWNLOAD=false

export MAX_GPU_SESSIONS=0
export PORT_MAIN=8188
export START_TIMEOUT="${START_TIMEOUT:-180}"

# Availability and global activation are separate. ENABLE_SAGE ensures the
# architecture-specific SageAttention bundle exists; COMFY_USE_SAGE_ATTENTION
# controls ComfyUI's global --use-sage-attention launch flag. Leaving the
# latter false keeps Sage available to KJ's per-workflow patch node while
# retaining Comfy Kitchen/default attention elsewhere.
export ENABLE_SAGE="${ENABLE_SAGE:-true}"
export COMFY_USE_SAGE_ATTENTION="${COMFY_USE_SAGE_ATTENTION:-false}"
